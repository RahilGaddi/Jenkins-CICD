pipeline {
    agent any 
        stages{
            stage('checkout')
            {
                step{
                    checkout scm
                }
            }
            stage('init'){
                steps{
                    dir('Jenkins-Basic-CICD'){
                        sh 'terraform init -input=false'
                    }
                }
            }
            stage('plan'){
                steps{
                    dir('Jenkins-Basic-CICD'){
                        sh 'terraform plan -input=false'
                    }
                }
            }
            stage('apply'){
                steps{
                    dir('Jenkins-Basic-CICD'){
                        sh 'terraform apply -input=false -auto-approve'
                    }
                }
            }
        }
}